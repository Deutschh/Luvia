generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum SignSource {
  SYSTEM
  USER
  MOCK
  IOT
}

enum DictionaryCategorySource {
  SYSTEM
  USER
}

model User {
  id              String               @id @default(uuid())
  name            String
  phone           String?
  email           String               @unique
  googleId        String?              @unique
  avatarUrl       String?
  authProvider    AuthProvider         @default(EMAIL)
  password        String?
  role            UserRole             @default(USER)
  refreshTokens   RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  dictionaryCategories DictionaryCategory[] @relation("UserOwnedCategories")
  dictionarySigns DictionarySign[]     @relation("UserOwnedSigns")
  favoriteSigns   FavoriteSign[]
  settings        UserSettings?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model DictionaryCategory {
  id             String                   @id @default(uuid())
  name           String
  normalizedName String
  slug           String                   @unique
  description    String?
  iconKey        String?
  ownerId        String?
  owner          User?                    @relation("UserOwnedCategories", fields: [ownerId], references: [id], onDelete: SetNull)
  source         DictionaryCategorySource @default(SYSTEM)
  signs          DictionarySign[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([ownerId, normalizedName], map: "DictionaryCategory_ownerId_normalizedName_key")
  @@index([ownerId])
}

model DictionarySign {
  id          String             @id @default(uuid())
  title       String
  normalizedTitle String
  description String?
  example     String?
  categoryId  String
  category    DictionaryCategory @relation(fields: [categoryId], references: [id])
  ownerId     String?
  owner       User?              @relation("UserOwnedSigns", fields: [ownerId], references: [id], onDelete: SetNull)
  isPublic    Boolean            @default(true)
  source      SignSource         @default(SYSTEM)
  favorites   FavoriteSign[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([categoryId, ownerId, normalizedTitle], map: "DictionarySign_categoryId_ownerId_normalizedTitle_key")
  @@index([categoryId])
  @@index([ownerId])
}

model FavoriteSign {
  id        String         @id @default(uuid())
  userId    String
  signId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sign      DictionarySign @relation(fields: [signId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, signId])
  @@index([userId])
  @@index([signId])
}

model UserSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceType            String   @default("natural")
  speechRate           Float    @default(1)
  speechVolume         Float    @default(1)
  autoSpeak            Boolean  @default(true)
  hapticFeedback       Boolean  @default(true)
  notificationsEnabled Boolean  @default(true)
  darkMode             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
